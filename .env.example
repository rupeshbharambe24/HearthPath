VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
# Admin role is now stored in the public.admin_users table (see
# docs/admin-verification-review-setup.md for the bootstrap workflow).

# Edge-function secrets are NOT read from this file. Set them on the Supabase project:
#   supabase secrets set GROQ_API_KEY=your-groq-key
#   (optional) LLM_PROVIDER=groq  LLM_MODEL=llama-3.3-70b-versatile
